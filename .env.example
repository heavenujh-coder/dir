# GEMINI_API_KEY: Google Gemini API 키 (서버 측 환경 변수 - AI Studio 및 Vercel 배포 시 권장)
# AI Studio에서는 Settings > Secrets에서 자동 주입됩니다.
# Vercel 배포 시 Project Settings > Environment Variables에 등록하세요.
GEMINI_API_KEY="AIzaSy..."

# VITE_GEMINI_API_KEY: (선택 사항) 클라이언트 직접 통신이 필요한 정적 배포 시 사용
VITE_GEMINI_API_KEY="AIzaSy..."

# APP_URL: 앱 호스팅 URL (AI Studio Cloud Run 호스팅 URL 자동 주입)
APP_URL="http://localhost:3000"

